{
  "name": "ekspersiz-mobile",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:ci-scripts": "node --test --test-isolation=none scripts/security-audit.test.mjs scripts/android-release.test.mjs scripts/android-r8.test.mjs scripts/android-branding.test.mjs scripts/ota-config.test.mjs",
    "release:check": "node scripts/android-release.mjs .env.production.local --check",
    "release:android": "node scripts/android-release.mjs",
    "audit:ci": "node scripts/security-audit.mjs",
    "check:config": "node scripts/check-config.mjs",
    "visual:compare": "node scripts/compare-screenshots.mjs",
    "visual:android:smoke": "node visual/ui-modernization-smoke.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/messaging": "^27.1.0",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@ronradtke/react-native-markdown-display": "9.0.3",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "^58.0.7",
    "expo-updates": "~58.0.20",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^11.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
