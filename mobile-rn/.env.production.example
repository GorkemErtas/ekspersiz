# Copy to ignored .env.production.local. All values must be real and reviewed.
# Android only; npm run release:android disables Expo's automatic dotenv loading.
APP_VARIANT=production
EXPO_PUBLIC_API_BASE_URL=https://ekspersiz-backend-production.up.railway.app/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_PUBLIC_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_SERVICES_FILE=../mobile/android/app/google-services.json
ANDROID_VERSION_NAME=1.0.2
ANDROID_VERSION_CODE=54
# Recheck all Play tracks, drafts and Bundle Explorer before every release.
# Maximum 53 confirmed by the owner in Play Console on 2026-10-31.
ANDROID_PLAY_MAX_VERSION_CODE=53
ANDROID_PLAY_SIGNING_SHA1=
ANDROID_PLAY_SIGNING_SHA256=
# Reuse the existing Flutter upload key. Passwords remain solely in ignored key.properties.
ANDROID_KEYSTORE_PROPERTIES_FILE=../mobile/android/key.properties
# Relative storeFile entries in Flutter key.properties resolve from android/app.
ANDROID_KEYSTORE_BASE_DIR=../mobile/android/app
