# Copy to ignored .env.production.local. All values must be real and reviewed.
# Android only; npm run release:android disables Expo's automatic dotenv loading.
APP_VARIANT=production
APP_CONFIG_MODE=native
EXPO_PUBLIC_API_BASE_URL=https://ekspersiz-backend-production.up.railway.app/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_PUBLIC_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_SERVICES_FILE=./secrets/google-services.production.json
ANDROID_VERSION_NAME=
ANDROID_VERSION_CODE=
# Recheck all Play tracks, drafts and Bundle Explorer before every release.
# Do not reuse the historical values in release reports as today's maximum.
ANDROID_PLAY_MAX_VERSION_CODE=
ANDROID_PLAY_SIGNING_SHA1=
ANDROID_PLAY_SIGNING_SHA256=
# Reuse the existing Play upload key. Passwords remain solely in ignored key.properties.
ANDROID_KEYSTORE_PROPERTIES_FILE=secrets/key.properties
# Relative storeFile entries resolve from ANDROID_KEYSTORE_BASE_DIR below.
ANDROID_KEYSTORE_BASE_DIR=secrets
# One-time native OTA migration needs explicit release authorization; see OTA_UPDATES.md.
EXPO_UPDATES_ENABLED=0
# EXPO_UPDATES_ENABLED=1
# EXPO_UPDATES_PROJECT_ID=883c68ec-f7e4-4c3e-87e2-e989c4b4b859
# EXPO_UPDATES_CHANNEL=staging
