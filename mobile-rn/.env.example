# Public build configuration. Never put service account keys or private keys here.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Native build input, kept outside version control. Development Firebase project only.
GOOGLE_SERVICES_FILE=
GOOGLE_SERVICES_PLIST=
GOOGLE_IOS_URL_SCHEME=
APP_VARIANT=development
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_PUBLIC_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_PUBLIC_KEY=
# Standard Play Integrity project number and request hash come from the authenticated backend challenge.
