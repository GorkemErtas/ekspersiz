# Public build configuration. Never put service account keys or private keys here.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Native client config, kept outside version control; must match this variant's package.
GOOGLE_SERVICES_FILE=
GOOGLE_SERVICES_PLIST=
GOOGLE_IOS_URL_SCHEME=
APP_VARIANT=development
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_PUBLIC_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_PUBLIC_KEY=
# Standard Play Integrity project number and request hash come from the authenticated backend challenge.
# Android production uses .env.production.example -> ignored .env.production.local.
# Required production-only inputs: ANDROID_VERSION_NAME, ANDROID_VERSION_CODE,
# ANDROID_PLAY_MAX_VERSION_CODE, ANDROID_PLAY_SIGNING_SHA1, ANDROID_PLAY_SIGNING_SHA256,
# ANDROID_KEYSTORE_PROPERTIES_FILE, ANDROID_KEYSTORE_BASE_DIR.
# See docs/production/ANDROID_RELEASE.md. No Gemini, RevenueCat secret, Places server
# key, JWT secret, Brevo key or Firebase admin/service-account JSON belongs in Expo env.
