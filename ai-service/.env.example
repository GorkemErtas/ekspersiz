# Server only. Export these values or use Docker --env-file; never put keys in the mobile app.
AI_SERVICE_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
GEMINI_API_KEY=replace-with-server-key-for-a-billing-enabled-project
DAMAGE_ANALYSIS_ENABLED=true
GEMINI_VISION_MODEL=gemini-3.8-flash
# Total provider-call budget, including a possible rate-limit retry.
GEMINI_VISION_TIMEOUT_SECONDS=35
GEMINI_VISION_MAX_OUTPUT_TOKENS=4096
GEMINI_VISION_RATE_LIMIT_RETRIES=1
# Pricing snapshot: 2026-10-25. Update when pricing/model changes.
GEMINI_VISION_INPUT_USD_PER_MILLION=0.75
GEMINI_VISION_OUTPUT_USD_PER_MILLION=3.75
# Existing assistant settings (keep its database and model independent).
DATABASE_URL=postgresql://app:replace-password@localhost:5432/vehicle_inspector
ASSISTANT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
ASSISTANT_EMBEDDING_LOCAL_ONLY=true
